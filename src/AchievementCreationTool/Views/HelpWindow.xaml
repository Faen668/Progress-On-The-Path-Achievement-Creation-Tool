<Window x:Class="AchievementCreationTool.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help - Achievement Creation Tool" Width="1000" Height="760" MinWidth="760" MinHeight="480"
        Background="{StaticResource Panel}" Foreground="{StaticResource Ink}">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="300" Background="{StaticResource PanelLow}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Help" FontSize="17" FontWeight="SemiBold" Margin="8,4,0,10" />
                <ListBox x:Name="TopicList" ItemsSource="{Binding Topics}" SelectedItem="{Binding Topic}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <FlowDocumentScrollViewer x:Name="Article" VerticalScrollBarVisibility="Auto" Padding="10,0" />
    </DockPanel>
</Window>
