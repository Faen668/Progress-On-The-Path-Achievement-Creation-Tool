<Window x:Class="AchievementCreationTool.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AchievementCreationTool.Controls"
        xmlns:l="clr-namespace:AchievementCreationTool.Logic"
        Title="Check and export" Width="760" Height="720" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" Foreground="{StaticResource Ink}" ShowInTaskbar="False">
    <Window.Resources>
        <c:Shows x:Key="Shows" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelLow}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Close" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                    <Button Content="Export" Style="{StaticResource Primary}" MinWidth="110" IsEnabled="{Binding CanExport}" Click="OnExport" />
                </StackPanel>
                <TextBlock Text="{Binding Done}" Foreground="{StaticResource Good}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18">
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource HelpButton}" Tag="export" Click="OnHelp" />
                    <TextBlock Text="Check and export" FontSize="17" FontWeight="SemiBold" />
                </DockPanel>
                <Border CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderThickness="1" Background="{Binding SummaryGround}" BorderBrush="{Binding SummaryLine}">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                </Border>
                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type l:Finding}">
                            <Border x:Name="Box" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" BorderThickness="1" Background="{StaticResource WarnGround}" BorderBrush="#5E4024">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource BadGround}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#6A3030" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="What gets written" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <Border Background="#101215" BorderBrush="#2A2E35" BorderThickness="1" CornerRadius="6" Padding="12">
                    <TextBlock Text="{Binding Layout}" FontFamily="Consolas" FontSize="12" Foreground="#C9CDD3" />
                </Border>

                <TextBlock Text="The game's folder" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
                    <TextBox Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged}" c:Placeholder.Text="such as C:\Program Files (x86)\Steam\steamapps\common\The Witcher 3" />
                </DockPanel>
                <TextBlock Text="{Binding GameNote}" Style="{StaticResource Hint}" Margin="0,4,0,0" />

                <TextBlock Text="The mod's folder name in mods\" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <TextBox Text="{Binding ModFolder, UpdateSourceTrigger=PropertyChanged}" c:Placeholder.Text="such as modVelenAdventures" />
                <TextBlock Text="It starts with mod, as the game's mod folders do." Style="{StaticResource Hint}" Margin="0,4,0,0" />

                <CheckBox Content="Also make a .zip ready for Nexus, beside the pack" IsChecked="{Binding MakeZip}" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
