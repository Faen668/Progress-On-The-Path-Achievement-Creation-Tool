<Window x:Class="AchievementCreationTool.Views.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AchievementCreationTool.Controls"
        Title="Choose an icon" Width="860" Height="700" MinWidth="700" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" Foreground="{StaticResource Ink}" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelLow}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                    <Button Content="Use this icon" IsDefault="True" Style="{StaticResource Primary}" MinWidth="120" Click="OnOk" />
                </StackPanel>
                <c:IconView Width="48" Height="48" Icon="{Binding Chosen}" Ring="{Binding Ring}" Folder="{Binding Folder}" Margin="0,0,10,0" />
                <c:IconView Width="48" Height="48" Icon="{Binding Chosen}" Ring="{Binding Ring}" Folder="{Binding Folder}" Locked="True" Margin="0,0,14,0" />
                <TextBlock Text="Ring" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="120" SelectedValue="{Binding Ring}" SelectedValuePath="Tag" VerticalAlignment="Center">
                    <ComboBoxItem Content="Gold" Tag="gold" />
                    <ComboBoxItem Content="Silver" Tag="silver" />
                    <ComboBoxItem Content="Bronze" Tag="bronze" />
                    <ComboBoxItem Content="None" Tag="none" />
                </ComboBox>
                <TextBlock Text="{Binding Chosen}" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <TabControl Margin="16,12,16,0" Background="Transparent">
            <TabItem Header="Progress on the Path's icons">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource HelpButton}" Tag="icons" Click="OnHelp" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" c:Placeholder.Text="Search the icons by name, such as crown, skull or card" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,6,0,8"
                               Text="Drawn for Progress on the Path, free to use in any pack. Locked achievements show them in red, unlocked ones in the ring's colour." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Builtins}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="104" Height="104" Margin="0,0,8,8" Padding="4" Click="OnBuiltin" Tag="{Binding}">
                                        <StackPanel>
                                            <c:IconView Width="56" Height="56" Icon="{Binding Icon}" Ring="{Binding DataContext.Ring, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="From the game">
                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Any item's picture from the game's own files. The game shows the real picture; this tool can't read the game's files, so it shows a frame in its place." />
                    <TextBox DockPanel.Dock="Top" Text="{Binding GameQuery, UpdateSourceTrigger=PropertyChanged}" c:Placeholder.Text="Search the game's items by name, such as Swallow or Aerondight" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="Or type a picture's path, as the game's menus name them" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" c:Placeholder.Text="such as icons/inventory/weapons/axe_01_64x128.png" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding GameRows}" SelectedItem="{Binding GamePicked}" Margin="0,8,0,0" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="Your own picture">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                               Text="A PNG or JPEG of your own. It's copied into the pack's folder, in icons\, and goes with the pack when it's exported. Square pictures look best; the overlay draws them up to 128 pixels." />
                    <Button Content="Choose a picture…" HorizontalAlignment="Left" Click="OnBrowse" />
                    <TextBlock Text="{Binding OwnProblem}" Foreground="{StaticResource Warn}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
