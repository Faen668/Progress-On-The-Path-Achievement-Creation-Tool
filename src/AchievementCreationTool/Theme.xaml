<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The overlay's own colours: a dark ground, gold for what matters, the red of a locked achievement -->
    <SolidColorBrush x:Key="Ground" Color="#14161A" />
    <SolidColorBrush x:Key="Panel" Color="#1C1F25" />
    <SolidColorBrush x:Key="PanelLow" Color="#181B20" />
    <SolidColorBrush x:Key="Raised" Color="#23272E" />
    <SolidColorBrush x:Key="Line" Color="#2F343C" />
    <SolidColorBrush x:Key="Ink" Color="#E8E6E1" />
    <SolidColorBrush x:Key="Muted" Color="#9AA0A8" />
    <SolidColorBrush x:Key="Gold" Color="#D4A84B" />
    <SolidColorBrush x:Key="GoldInk" Color="#1A1406" />
    <SolidColorBrush x:Key="GoldGround" Color="#2A2418" />
    <SolidColorBrush x:Key="GoldLine" Color="#8A6E2F" />
    <SolidColorBrush x:Key="Good" Color="#6FBF8A" />
    <SolidColorBrush x:Key="GoodGround" Color="#17241C" />
    <SolidColorBrush x:Key="Warn" Color="#F0A35E" />
    <SolidColorBrush x:Key="WarnGround" Color="#2B2015" />
    <SolidColorBrush x:Key="Bad" Color="#E8786A" />
    <SolidColorBrush x:Key="BadGround" Color="#2E1A1A" />

    <!-- A card: one part of the editor -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Gold}" />
        <Setter Property="Foreground" Value="{StaticResource GoldInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="#262B33" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The ? beside a part of the window: opens the guide at what that part does. Its Tag is the topic. -->
    <Style x:Key="HelpButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Content" Value="?" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Gold}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ToolTip" Value="What's this? (F1)" />
    </Style>

    <!-- A link into the guide, in a hint's place -->
    <Style x:Key="HelpLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Gold}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists: each row the full width, so what's on its right sits at the edge, and not as tall as Fluent's -->
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
</ResourceDictionary>
